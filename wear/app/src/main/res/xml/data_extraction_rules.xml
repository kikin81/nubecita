<?xml version="1.0" encoding="utf-8"?>
<!--
    Nothing on the watch is backed up or transferred: everything it stores is a
    disposable copy of what the phone app sends, and restoring it could show a
    previous account's posts and messages on a new watch.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
