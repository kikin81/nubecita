<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Branded launch (Wear quality guideline WO-V15): the round launcher icon
        at 48dp on a black background, as the guideline requires. icon_preferred
        is required: without it the system shows this launch with no icon at all.
    -->
    <style name="Theme.NubecitaWear" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@android:color/black</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_screen</item>
        <item name="android:windowSplashScreenBehavior">icon_preferred</item>
        <item name="postSplashScreenTheme">@style/Theme.NubecitaWear.PostSplash</item>
    </style>

    <style name="Theme.NubecitaWear.PostSplash" parent="android:Theme.DeviceDefault">
        <item name="android:windowBackground">@android:color/black</item>
    </style>
</resources>
