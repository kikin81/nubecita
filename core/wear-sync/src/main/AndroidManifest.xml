<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!--
            Woken only for Nubecita's own /v1/ traffic (never a catch-all
            filter), so unrelated Data Layer messages don't start the process.
        -->
        <service
            android:name=".internal.NubecitaWearListenerService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data
                    android:host="*"
                    android:pathPrefix="/v1/sync/"
                    android:scheme="wear" />
            </intent-filter>
        </service>
    </application>
</manifest>
