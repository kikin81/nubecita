require "fileutils"
require "shellwords"
require "tmpdir"

# fastlane regenerates fastlane/README.md on every run by default, which
# clobbers the hand-written invocation / auth / env-var docs we maintain
# there. skip_docs disables that so the README stays human-authored.
skip_docs

default_platform(:android)

# Env vars consumed by app/build.gradle.kts's keystoreValue() helper.
# Surface a clear error before any upload attempt if any are missing —
# without this, gradle silently signs nothing and supply uploads an
# unsigned AAB that Play Console rejects deep in the request lifecycle
# with a confusing "Upload failed" message.
REQUIRED_KEYSTORE_ENV = %w[KEYSTORE_FILE KEYSTORE_PASSWORD KEY_ALIAS KEY_PASSWORD].freeze

# Play Console caps changelog at 500 chars per locale. We truncate
# defensively so a long placeholder / unbounded env var doesn't fail
# the upload mid-request with a hard-to-debug "field too long" error.
PLAY_CHANGELOG_MAX_CHARS = 500

# Downstream tracks the `promote` lane can target, by Play track id:
# alpha = closed testing, beta = open testing, production = production.
# (internal is the CI landing track — the source, never a promote target.)
PROMOTE_TRACKS = %w[alpha beta production].freeze

# The Wear OS form factor's internal track (Play gives Wear its own tracks).
WEAR_INTERNAL_TRACK = "wear:internal"

# The `promote` lane's logical tracks → the Wear form factor's Play track ids
# (read via the Play API on 2026-10-26; ids are case-sensitive, and the closed
# track was created in the Console as "Closed").
WEAR_PROMOTE_TRACKS = { "alpha" => "wear:Closed", "beta" => "wear:beta", "production" => "wear:production" }.freeze

# Which app(s) the `promote` lane moves: the phone bundle, the Wear bundle, or both.
PROMOTE_APPS = %w[phone wear both].freeze

# The Wear bundle's versionCode is the phone's plus this offset, for the same
# version (build-logic WearVersioning.kt, WEAR_VERSION_CODE_OFFSET).
WEAR_VERSION_CODE_OFFSET = 1_000_000_000

# Release bundles by explicit path: the phone and Wear apps share an
# applicationId, so each upload names its own AAB rather than reading
# GRADLE_AAB_OUTPUT_PATH, which holds whichever bundle Gradle built last.
PHONE_RELEASE_AAB = File.expand_path("../app/build/outputs/bundle/productionRelease/app-production-release.aab", __dir__)
WEAR_RELEASE_AAB = File.expand_path("../wear/app/build/outputs/bundle/productionRelease/app-production-release.aab", __dir__)

# Returns path, failing loudly if the bundle wasn't built (e.g. a task rename).
def nubecita_existing_aab(path)
  UI.user_error!("Expected release bundle not found: #{path}") unless File.exist?(path)
  path
end

# Locale buckets that ship framed marketing screenshots. en-US is the source of
# truth (the journey captures it); the others reuse those captures with a
# localized title band (see the `localize_marketing_screenshots` lane). The app
# UI in every bucket is English until the app itself ships localized strings —
# only the baked-in headline differs per locale.
MARKETING_SOURCE_LOCALE = "en-US"
MARKETING_LOCALIZED = %w[es-419 pt-BR].freeze
MARKETING_LOCALES = ([MARKETING_SOURCE_LOCALE] + MARKETING_LOCALIZED).freeze

# Resolve fastlane/metadata/android robustly. Plain Ruby in a lane body runs
# with CWD = the fastlane/ dir, while fastlane ACTIONS (gradle, frameit, …)
# chdir to the project root — so a single relative path can't serve both.
# Probe both layouts instead of guessing.
def nubecita_metadata_android_dir
  [
    File.join(Dir.pwd, "metadata", "android"),             # CWD = fastlane/
    File.join(Dir.pwd, "fastlane", "metadata", "android"), # CWD = project root
  ].find { |d| File.directory?(d) } ||
    UI.user_error!("Could not locate fastlane/metadata/android from #{Dir.pwd}")
end

# Normalize a CLI/ENV value: blank/whitespace-only → nil (so `x || fallback`
# works; Ruby treats "" as truthy, which would otherwise defeat the fallback).
def nubecita_blank(value)
  s = value.to_s.strip
  s.empty? ? nil : s
end

# Resolve the promote target per app as { "phone" => code, "wear" => code }
# (only the selected apps). One version is promoted, so with app "both" the
# Wear code is the phone code plus the offset, and it must be on wear:internal.
# An explicit version_code may be given in either band. Fails loudly when the
# Wear build for that version is missing (a release from before the Wear app).
def nubecita_resolve_promote_targets(app, version_code_option)
  UI.user_error!("Unknown app '#{app}'. Valid: #{PROMOTE_APPS.join(', ')}") unless PROMOTE_APPS.include?(app)
  explicit = nubecita_blank(version_code_option)&.to_i
  phone_band = explicit && (explicit >= WEAR_VERSION_CODE_OFFSET ? explicit - WEAR_VERSION_CODE_OFFSET : explicit)
  targets = {}
  if app != "wear"
    targets["phone"] = phone_band || (google_play_track_version_codes(track: "internal") || []).map(&:to_i).max ||
      UI.user_error!("No internal version code found to promote")
  end
  if app != "phone"
    wear_internal = (google_play_track_version_codes(track: WEAR_INTERNAL_TRACK) || []).map(&:to_i)
    base = targets["phone"] || phone_band
    wear_vc = base ? base + WEAR_VERSION_CODE_OFFSET : wear_internal.max
    UI.user_error!("No #{WEAR_INTERNAL_TRACK} version code found to promote") unless wear_vc
    unless wear_internal.include?(wear_vc)
      UI.user_error!("Wear versionCode #{wear_vc} is not on #{WEAR_INTERNAL_TRACK} (has: #{wear_internal.join(', ')}). " \
        "Promote app:phone for a release without a Wear build.")
    end
    targets["wear"] = wear_vc
  end
  targets
end

# A warning (never a block) when the Wear build would reach production ahead of
# the phone build production users get: a watch paired with an older phone may
# be missing what it needs. Staged rollouts mean this can't prove users have the
# phone build anyway; it catches promoting the watch alone or out of order.
# Returns the warning text, or nil.
def nubecita_wear_ahead_warning(targets, tracks)
  wear_vc = targets["wear"]
  return nil unless wear_vc && tracks.include?("production")
  wear_base = wear_vc - WEAR_VERSION_CODE_OFFSET
  return nil if targets["phone"] && targets["phone"] >= wear_base # the phone goes to production in the same run
  phone_prod = (google_play_track_version_codes(track: "production") || []).map(&:to_i).max
  return nil if phone_prod && phone_prod >= wear_base
  "Wear #{wear_vc} would reach production ahead of the phone (production phone: #{phone_prod || 'none'}, " \
    "Wear needs #{wear_base}+). Watches paired with an older phone may lack what this Wear build needs."
end

# Promote one app's internal build to the given logical tracks (alpha/beta/
# production). Wear maps them to its own form-factor tracks and promotes from
# wear:internal; rollout and priority stay production-only for both apps.
def nubecita_promote_app(app, vc, tracks, prod_rollout, prod_priority)
  source = app == "wear" ? WEAR_INTERNAL_TRACK : "internal"
  tracks.each do |logical|
    target = app == "wear" ? WEAR_PROMOTE_TRACKS.fetch(logical) : logical
    production = logical == "production"
    # Guard against nil — a never-released track (e.g. an empty beta) can yield
    # nil rather than [], and .map on nil would crash the promote mid-batch.
    version_codes = google_play_track_version_codes(track: target) || []
    already_on_target = version_codes.map(&:to_i).include?(vc)
    # Testing tracks are always 100% (no staged rollout to advance), so a
    # re-promote of a build already live on a testing track is a redundant Play
    # API call that can fail as an already-completed release — skip it. Only
    # production re-runs to advance its staged rollout.
    if already_on_target && !production
      UI.message("[#{app}] versionCode #{vc} already on #{target}; nothing to advance — skipping.")
      next
    end
    rollout = production ? prod_rollout : "1.0"
    # in_app_update_priority is IMMUTABLE per release: set it only on the
    # INITIAL promote to a track (production only), never on a rollout-advance
    # re-run. Testing tracks never carry a priority.
    priority = (production && !already_on_target) ? prod_priority : nil
    UI.message("[#{app}] #{already_on_target ? 'Advancing rollout for' : 'Promoting'} versionCode #{vc} → #{target} @ #{rollout}")

    # Promote from the internal track (where CI lands every build) via
    # track_promote_to. supply's promote_track reads the release from the SOURCE
    # track and writes it to the target WITHOUT modifying the source, so the
    # build stays on internal and one batch can promote it to several tracks.
    # (supply's "direct" path — track: <target> with no track_promote_to — does
    # NOT create a release from the bundle library; it looks for an EXISTING
    # release on <target> to update and errors "Unable to find the requested
    # release on track" when absent. Verified empirically on PR #754's test run
    # and in supply/uploader.rb#promote_track.)
    # The one already_on_target case is production advancing its staged rollout,
    # which updates the existing production release in place (no track_promote_to).
    # NOTE: promote_track requires the version code to be a live release on the
    # SOURCE track — promoting an OLD, superseded internal build (an explicit
    # older version_code) is unsupported; promote the latest internal build.
    upload_to_play_store(
      track: already_on_target ? target : source,
      track_promote_to: already_on_target ? nil : target,
      version_code: vc,
      rollout: rollout,
      in_app_update_priority: priority,
      metadata_path: nubecita_metadata_android_dir,         # committed en-US/es-419/pt-BR changelogs
      skip_upload_changelogs: false,                        # the localized-notes upload
      skip_upload_apk: true, skip_upload_aab: true,
      skip_upload_metadata: true,                           # listing text / images untouched
      skip_upload_images: true, skip_upload_screenshots: true,
    )
  end
end

# Stage the committed framed marketing screenshots (every device bucket) into
# <dest_metadata>/<locale>/images/<bucket>/, stripping the `_framed` suffix so
# Play receives clean filenames. Only `*_framed.jpg` are committed (raw PNG
# captures are gitignored), so this never double-uploads. Fails loudly on a
# PARTIAL bucket: a capture lane runs exit_on_test_failure:false, so a failed
# journey method could leave a screen missing, and uploading that would ship an
# incomplete listing. Returns the number of images staged.
def nubecita_stage_marketing_screenshots(dest_metadata, locale: "en-US")
  base = File.join(nubecita_metadata_android_dir, locale, "images")
  titles = File.join(base, "phoneScreenshots", "title.strings")
  # A locale listed in MARKETING_LOCALES but not yet set up (no title.strings)
  # contributes nothing rather than crashing the upload with Errno::ENOENT.
  return 0 unless File.exist?(titles)
  expected = File.readlines(titles).map { |line| line[/^\s*"([^"]+)"\s*=/, 1] }.compact
  staged = 0
  Dir.glob(File.join(base, "*Screenshots")).each do |bucket_dir|
    framed = Dir.glob(File.join(bucket_dir, "*_framed.jpg"))
    next if framed.empty?
    missing = expected - framed.map { |f| File.basename(f).sub(/_framed\.jpg\z/, "") }
    unless missing.empty?
      UI.user_error!(
        "Marketing screenshots incomplete in #{File.basename(bucket_dir)}: missing " \
          "#{missing.join(', ')}. Re-run `fastlane screenshots` / `screenshots_tablet`, " \
          "or delete the bucket to skip it."
      )
    end
    dest_dir = File.join(dest_metadata, locale, "images", File.basename(bucket_dir))
    FileUtils.mkdir_p(dest_dir)
    framed.each { |src| FileUtils.cp(src, File.join(dest_dir, File.basename(src).sub("_framed", ""))) }
    staged += framed.size
  end
  staged
end

# Stage the raw Wear captures (images/wearScreenshots/*.png) for [locale] into
# a supply metadata tree. Unlike the phone/tablet buckets there are no
# *_framed.jpg files: Play rejects framed or masked Wear screenshots (WO-G5),
# so the committed 1:1 captures from `wear_screenshots` ARE the listing images.
# A locale without Wear captures stages nothing, and Play then shows the
# default-language (en-US) Wear set for it.
def nubecita_stage_wear_screenshots(dest_metadata, locale: "en-US")
  src_dir = File.join(nubecita_metadata_android_dir, locale, "images", "wearScreenshots")
  shots = Dir.glob(File.join(src_dir, "*.png")).sort
  return 0 if shots.empty?
  dest_dir = File.join(dest_metadata, locale, "images", "wearScreenshots")
  FileUtils.mkdir_p(dest_dir)
  FileUtils.cp(shots, dest_dir)
  shots.size
end

platform :android do
  desc "Build the signed Wear release AAB and upload it to the Play Console wear:internal track."
  lane :internal_wear do
    missing = REQUIRED_KEYSTORE_ENV.reject { |k| ENV[k] && !ENV[k].empty? }
    unless missing.empty?
      UI.user_error!(
        "Missing required keystore env vars: #{missing.join(', ')}. " \
          "See fastlane/README.md for the local-dev setup."
      )
    end

    # Wear OS uploads go to dedicated form-factor tracks (nubecita-sn52.4):
    # wear:internal, wear:beta and wear:production, listed via the Play API on
    # 2026-10-25. Fail loudly with a clear message if the track is missing
    # (e.g. the Wear OS form factor was removed in Play Console) instead of a
    # raw supply error mid-upload. The lookup is read-only.
    begin
      google_play_track_version_codes(track: WEAR_INTERNAL_TRACK)
    rescue StandardError => e
      UI.user_error!(
        "Play track '#{WEAR_INTERNAL_TRACK}' is not available (#{e.message}). " \
          "Enable the Wear OS form factor in Play Console (Test and release > Advanced settings > Form factors)."
      )
    end

    # Flavor-qualified for the same reason as :app: the unqualified task would
    # also build the bench bundle (fake phone sources) with the same applicationId.
    # The Wear versionCode sits in its own band (1_000_000_000 + the phone code),
    # computed by the nubecita.android.wear.application convention plugin.
    gradle(task: ":wear:app:bundleProductionRelease")

    release_notes = ENV["PLAY_RELEASE_NOTES"]
    release_notes = "Internal build — wire PLAY_RELEASE_NOTES for human-readable notes." if release_notes.nil? || release_notes.empty?

    # Same changelog-only metadata trick as the phone `internal` lane below
    # (see the comment there for why metadata_path is the locale root).
    Dir.mktmpdir("nubecita-fastlane-wear-metadata") do |metadata_path|
      changelog_dir = File.join(metadata_path, "en-US", "changelogs")
      FileUtils.mkdir_p(changelog_dir)
      File.write(
        File.join(changelog_dir, "default.txt"),
        release_notes.to_s[0, PLAY_CHANGELOG_MAX_CHARS]
      )

      upload_to_play_store(
        track: WEAR_INTERNAL_TRACK,
        aab: nubecita_existing_aab(WEAR_RELEASE_AAB),
        metadata_path: metadata_path,
        skip_upload_apk: true,
        skip_upload_metadata: true,
        skip_upload_images: true,
        skip_upload_screenshots: true,
      )
    end
  end

  desc "Build a signed release AAB and upload it to the Play Console internal track."
  lane :internal do
    missing = REQUIRED_KEYSTORE_ENV.reject { |k| ENV[k] && !ENV[k].empty? }
    unless missing.empty?
      UI.user_error!(
        "Missing required keystore env vars: #{missing.join(', ')}. " \
          "See fastlane/README.md for the local-dev setup."
      )
    end

    # Flavor-qualified: :app's `environment` dimension makes the unflavored
    # `bundleRelease` aggregate both productionRelease + benchRelease AABs.
    # Both share the same applicationId (net.kikin.nubecita), so without
    # this qualifier `SharedValues::GRADLE_AAB_OUTPUT_PATH` would be
    # populated non-deterministically and could send the bench AAB — the
    # one with fake-network DI swapped in — to Play Console. Bench AABs
    # are reserved for Macrobench (nubecita-crmi.6 Section B onwards).
    #
    # Project-qualified too (nubecita-50gj): since :wear:app gained its own
    # productionRelease variant, the bare `bundleProductionRelease` built BOTH
    # bundles and GRADLE_AAB_OUTPUT_PATH pointed at the Wear AAB, which this
    # lane then tried to upload to the phone track (Play rejected it). The
    # upload below also names the phone AAB explicitly instead of trusting
    # "the last bundle Gradle built".
    gradle(task: ":app:bundleProductionRelease")

    release_notes = ENV["PLAY_RELEASE_NOTES"]
    release_notes = "Internal build — wire PLAY_RELEASE_NOTES for human-readable notes." if release_notes.nil? || release_notes.empty?

    # supply reads changelogs from <metadata_path>/<locale>/changelogs/default.txt.
    # When `metadata_path` is overridden (as it is here), it points DIRECTLY at
    # the locale-rooted tree — the `android/` segment that appears under the
    # default `./fastlane/metadata/android/<locale>/...` layout is fastlane's
    # platform prefix and MUST NOT be reintroduced under an overridden path,
    # or supply will scan the tmpdir, find a single directory named "android",
    # treat that string as a locale, and call
    # `get_edit_listing(language: "android")` — which Play Console rejects with
    # a 400 "Invalid request". We synthesize a single en-US changelog in a
    # per-run tmpdir so the only field that leaves this lane is the release
    # note — listing metadata, images, and screenshots are all skip_upload_*'d.
    #
    # Screenshots are deliberately NOT uploaded here. semantic-release fires
    # this lane on every feat/fix (10+×/day), and re-uploading identical
    # screenshots each time is wasteful and would clobber any Console-side
    # edits. The committed marketing screenshots are pushed by the separate
    # `upload_screenshots` lane, run from
    # `.github/workflows/screenshots-upload.yaml` only when the committed images
    # actually change on main.
    Dir.mktmpdir("nubecita-fastlane-metadata") do |metadata_path|
      changelog_dir = File.join(metadata_path, "en-US", "changelogs")
      FileUtils.mkdir_p(changelog_dir)
      File.write(
        File.join(changelog_dir, "default.txt"),
        release_notes.to_s[0, PLAY_CHANGELOG_MAX_CHARS]
      )

      upload_to_play_store(
        track: "internal",
        # Optional: a manual release.yaml dispatch can force a priority for the
        # internal upload; the automatic push path leaves it unset → Play default 0.
        in_app_update_priority: nubecita_blank(ENV["IN_APP_UPDATE_PRIORITY"])&.to_i,
        aab: nubecita_existing_aab(PHONE_RELEASE_AAB),
        metadata_path: metadata_path,
        skip_upload_apk: true,
        skip_upload_metadata: true,
        skip_upload_images: true,
        skip_upload_screenshots: true,
      )
    end
  end

  desc "Print the version code(s) the promote lane would target."
  desc "Pass app:phone|wear|both (default phone, as in the workflow) and an optional version_code."
  lane :resolve_promote_target do |options|
    app = nubecita_blank(options[:app]) || "phone"
    targets = nubecita_resolve_promote_targets(app, options[:version_code])
    # Machine-readable markers the promote workflow greps out of fastlane's log.
    puts "RESOLVED_VERSION_CODE=#{targets['phone']}" if targets["phone"]
    puts "RESOLVED_WEAR_VERSION_CODE=#{targets['wear']}" if targets["wear"]
    tracks = nubecita_blank(options[:tracks]).to_s.split(",").map(&:strip)
    warning = nubecita_wear_ahead_warning(targets, tracks)
    puts "WEAR_AHEAD_WARNING=#{warning}" if warning
  end

  desc "Promote internal builds to one or more tracks (alpha/beta/production), with"
  desc "localized notes. Pass tracks:\"alpha,beta,production\" (comma-separated) and"
  desc "app:phone|wear|both (default phone, as in the workflow); Wear maps them to its own Play tracks."
  lane :promote do |options|
    app = nubecita_blank(options[:app]) || "phone"
    tracks = nubecita_blank(options[:tracks]).to_s.split(",").map(&:strip).reject(&:empty?)
    UI.user_error!("No tracks selected (pass tracks:\"alpha,beta,production\")") if tracks.empty?
    bad = tracks - PROMOTE_TRACKS
    UI.user_error!("Unknown track(s): #{bad.join(', ')}. Valid: #{PROMOTE_TRACKS.join(', ')}") unless bad.empty?

    # rollout + priority are production-only knobs (D6); testing tracks always go
    # 100% with no priority. Validate the production inputs up front regardless of
    # whether production is selected — a bad value is an operator error worth
    # surfacing before any track is touched.
    prod_rollout = nubecita_blank(options[:rollout]) || "0.1"
    UI.user_error!("Rollout must be in (0.0, 1.0] (got: #{prod_rollout})") unless prod_rollout.to_f > 0.0 && prod_rollout.to_f <= 1.0
    # Validate priority as an integer string: bare `.to_i` turns "foo" into 0,
    # which would silently pass the range check as a valid priority of 0.
    prod_priority_raw = nubecita_blank(options[:priority])
    prod_priority = nil
    if prod_priority_raw
      UI.user_error!("Priority must be an integer (got: #{prod_priority_raw})") unless prod_priority_raw =~ /\A\d+\z/
      prod_priority = prod_priority_raw.to_i
      UI.user_error!("Priority must be 0..5 (got: #{prod_priority})") unless prod_priority.between?(0, 5)
    end

    targets = nubecita_resolve_promote_targets(app, options[:version_code])

    # Every locale must have a non-empty default.txt within Play's per-locale cap,
    # else supply ships a partial set or fails the upload mid-request. Validate
    # once, before promoting any track.
    %w[en-US es-419 pt-BR].each do |loc|
      f = File.join(nubecita_metadata_android_dir, loc, "changelogs", "default.txt")
      text = File.exist?(f) ? File.read(f).strip : ""
      UI.user_error!("Missing/empty changelog: #{f}") if text.empty?
      UI.user_error!("Changelog #{loc} exceeds #{PLAY_CHANGELOG_MAX_CHARS} chars (#{text.length})") if text.length > PLAY_CHANGELOG_MAX_CHARS
    end

    warning = nubecita_wear_ahead_warning(targets, tracks)
    UI.important(warning) if warning

    # Phone first, so with app "both" the phone reaches production before the watch.
    %w[phone wear].each do |a|
      nubecita_promote_app(a, targets[a], tracks, prod_rollout, prod_priority) if targets[a]
    end
  end

  desc "Upload the committed framed marketing screenshots to the Play listing."
  desc "Run from .github/workflows/screenshots-upload.yaml on image changes — NOT on every release."
  lane :upload_screenshots do
    Dir.mktmpdir("nubecita-fastlane-screenshots") do |metadata_path|
      # Stage every locale bucket (en-US + localized). A locale with no committed
      # *_framed.jpg yet contributes nothing; only complete buckets are staged.
      staged = MARKETING_LOCALES.sum { |loc| nubecita_stage_marketing_screenshots(metadata_path, locale: loc) }
      # Plus the raw Wear set, per locale that has one.
      staged += MARKETING_LOCALES.sum { |loc| nubecita_stage_wear_screenshots(metadata_path, locale: loc) }
      if staged.zero?
        UI.important("No committed marketing or Wear screenshots found — nothing to upload.")
        next
      end
      # supply uploads listing metadata (incl. screenshots) INSIDE a
      # version-codes loop (supply/uploader.rb#perform_upload_meta): even though
      # store images are APP-LEVEL (the Play API keys them by language + image
      # type, with no track), supply hard-requires a version_code whose release
      # exists to anchor the edit, or it dies with "Could not find release for
      # version code '' to update changelog". So we look up what is ACTUALLY
      # live on the internal track (where the release lane uploads the AAB) and
      # anchor to that — NOT a gradle/build version, which this decoupled
      # screenshots workflow can't guarantee has reached Play yet. The track +
      # version_code below only satisfy supply's anchor; the screenshots still
      # update the single global store listing. Listing TEXT + icon/feature
      # graphic stay skipped.
      version_codes = google_play_track_version_codes(track: "internal")
      if version_codes.empty?
        UI.important(
          "No release on the internal track yet — nothing to anchor a listing edit to. " \
            "Skipping screenshot upload.",
        )
        next
      end

      UI.message("Uploading #{staged} marketing screenshot(s), anchored to internal version code #{version_codes.max}.")
      upload_to_play_store(
        track: "internal",
        version_code: version_codes.max,
        skip_upload_apk: true,
        skip_upload_aab: true,
        skip_upload_metadata: true,
        skip_upload_changelogs: true,
        skip_upload_images: true,
        skip_upload_screenshots: false,
        metadata_path: metadata_path,
      )
    end
  end

  desc "Capture + frame all Play Store marketing screenshots from the bench flavor."
  desc "Pass device:<adb serial> to disambiguate when multiple devices are attached."
  lane :screenshots do |options|
    # Bench flavor → deterministic, already-signed-in fake data with bundled
    # android_asset images. Build the two APKs the Screenfile points at, then
    # let screengrab install them, run MarketingScreenshotJourney, and pull the
    # PNGs into fastlane/metadata/android/<locale>/images/. Upload to Play is a
    # separate step (the `upload_screenshots` lane / screenshots-upload.yaml).
    # Scope to :app — the unqualified task names would also build every
    # feature module's bench androidTest, and those access internal composables
    # only reachable from their productionDebug test variant (they fail to
    # compile under bench). screengrab only needs :app's two APKs.
    gradle(task: ":app:assembleBenchDebug")
    gradle(task: ":app:assembleBenchDebugAndroidTest")

    # Config is passed inline (not via a Screenfile): the
    # capture_android_screenshots *action* doesn't read fastlane/Screenfile the
    # way the standalone `screengrab` CLI does, so an explicit app_apk_path is
    # required — otherwise screengrab auto-discovers every APK under app/build
    # and can't pick one non-interactively.
    capture_android_screenshots(
      app_package_name: "net.kikin.nubecita",
      tests_package_name: "net.kikin.nubecita.test",
      # Bench-flavor debug APKs: signed-in fake session + deterministic
      # timeline with bundled android_asset images.
      app_apk_path: "app/build/outputs/apk/bench/debug/app-bench-debug.apk",
      tests_apk_path: "app/build/outputs/apk/androidTest/bench/debug/app-bench-debug-androidTest.apk",
      # Run only the marketing journey, not the unrelated :app androidTests.
      use_tests_in_classes: ["net.kikin.nubecita.screenshots.MarketingScreenshotJourney"],
      # The module runner swaps in HiltTestApplication so the @AndroidEntryPoint
      # MainActivity launches under the bench Hilt graph.
      test_instrumentation_runner: "net.kikin.nubecita.core.testing.android.HiltTestRunner",
      locales: ["en-US"],
      clear_previous_screenshots: true,
      reinstall_app: true,
      # Don't abort the whole run (and skip the pull) if one journey method
      # fails — keep the screens that did capture.
      exit_on_test_failure: false,
      # nil → screengrab's default single-device selection; required only when
      # more than one emulator/device is attached.
      specific_device: options[:device],
    )

    # Strip screengrab's timestamp suffix (01_feed_1780383507366.png →
    # 01_feed.png) so frameit's title.strings keys stay stable across runs.
    Dir.glob(File.join(nubecita_metadata_android_dir, "*", "images", "*Screenshots", "*.png")).each do |path|
      next if File.basename(path).include?("_framed")
      cleaned = File.basename(path, ".png").sub(/_\d{6,}\z/, "")
      dest = File.join(File.dirname(path), "#{cleaned}.png")
      File.rename(path, dest) unless path == dest
    end

    frame_marketing_screenshots
  end

  desc "Wrap raw captures in a device frame + backdrop + localized title (fastlane frameit)."
  lane :frame_marketing_screenshots do
    # frameit (frame_screenshots) reads fastlane/metadata/android/Framefile.json
    # for the backdrop/title styling and each locale's images/*/title.strings for
    # the headline, then composites the screenshot into a device frame.
    #
    # HARD REQUIREMENT — capture resolution must match a frameit device in
    # device_types.rb, else it aborts with "Unsupported screen size". The bench
    # journey is captured on a Pixel-5-class display (1080x2340 @ 432dpi); the
    # default `gphone16k` AVD is 1280x2856 (NOT supported). Override before
    # capture with:
    #   adb -s <serial> shell wm size 1080x2340 && adb -s <serial> shell wm density 432
    # (reset afterwards with `wm size reset` / `wm density reset`), or use a
    # Pixel 5 AVD. Requires ImageMagick (`brew install imagemagick`).
    frame_screenshots(path: "./fastlane/metadata/android")

    # frameit emits 24-bit *_framed.png; convert to high-quality JPG (Play
    # accepts JPEG and these have no transparency) so the committed marketing
    # assets stay well under the repo's 500 KB large-file limit. The PNGs are
    # gitignored intermediates.
    Dir.glob(File.join(nubecita_metadata_android_dir, "*", "images", "*Screenshots", "*_framed.png")).each do |png|
      sh("magick #{png.shellescape} -quality 90 #{png.sub(/\.png\z/, '.jpg').shellescape}")
      File.delete(png)
    end
  end

  desc "Generate the LOCALIZED marketing screenshots (es-419, pt-BR …)."
  desc "Reuses the en-US captures; only the framed title band is localized. Needs"
  desc "the en-US raw *.png present (run `screenshots` + `screenshots_tablet` first)."
  lane :localize_marketing_screenshots do
    base = nubecita_metadata_android_dir
    src_phone = File.join(base, MARKETING_SOURCE_LOCALE, "images", "phoneScreenshots")
    src_ten = File.join(base, MARKETING_SOURCE_LOCALE, "images", "tenInchScreenshots")
    raw = ->(dir) { Dir.glob(File.join(dir, "[0-9]*.png")).reject { |f| f.include?("_framed") } }
    if raw.call(src_phone).empty? || raw.call(src_ten).empty?
      UI.user_error!(
        "No en-US raw captures in #{MARKETING_SOURCE_LOCALE}. Run `fastlane screenshots " \
          "device:<phone>` and `fastlane screenshots_tablet device:<tablet>` first — the " \
          "raw *.png are gitignored, so a fresh checkout has only the framed JPGs.",
      )
    end

    MARKETING_LOCALIZED.each do |loc|
      dst_phone = File.join(base, loc, "images", "phoneScreenshots")
      dst_ten = File.join(base, loc, "images", "tenInchScreenshots")
      titles = File.join(dst_phone, "title.strings")
      UI.user_error!("Missing #{titles} — add the localized headlines first.") unless File.exist?(titles)
      [dst_phone, dst_ten].each { |d| FileUtils.mkdir_p(d) }

      # Reuse the en-US captures — the app UI is English until app i18n lands.
      # Drop stale raw PNGs AND framed JPGs so a shot removed from the source
      # doesn't linger as an orphaned _framed.jpg in the localized bucket.
      Dir.glob(File.join(dst_phone, "*.{png,jpg}")).each { |f| File.delete(f) }
      Dir.glob(File.join(dst_ten, "*.{png,jpg}")).each { |f| File.delete(f) }
      raw.call(src_phone).each { |f| FileUtils.cp(f, dst_phone) }
      raw.call(src_ten).each { |f| FileUtils.cp(f, dst_ten) }

      # Phone: frameit, scoped to THIS locale's bucket so it doesn't scan the
      # tablet bucket (whose resolution frameit can't frame). Then PNG → JPG.
      frame_screenshots(path: dst_phone)
      Dir.glob(File.join(dst_phone, "*_framed.png")).each do |png|
        sh("magick #{png.shellescape} -quality 90 #{png.sub(/\.png\z/, '.jpg').shellescape}")
        File.delete(png)
      end

      # Tablet: backdrop+title composite (reads this locale's title.strings).
      sh("bash #{File.expand_path('../../frameit_assets/compose_tablet.sh', base).shellescape} #{loc.shellescape}")
      UI.success("Localized marketing screenshots generated for #{loc}.")
    end
  end

  desc "Capture + backdrop-frame the TABLET (tenInch) marketing screenshots."
  desc "Run against a tablet device/emulator: pass device:<adb serial>."
  lane :screenshots_tablet do |options|
    serial = options[:device] || UI.user_error!("Pass device:<adb serial> for a tablet device.")

    # TRAP (nubecita-faok): if the journey fails with "Unable to resolve activity
    # for … MainActivity" and "Captured 0 new screenshots", the tablet AVD's /data
    # is corrupted — PackageManager still lists MainActivity + its filters, but the
    # activity won't resolve/launch (the identical APK launches fine on a healthy
    # AVD). A plain uninstall/reinstall does NOT fix it. Cold-boot the AVD with a
    # data wipe first, then re-run:
    #   $ANDROID_HOME/emulator/emulator -avd Pixel_Tablet -no-snapshot -wipe-data
    gradle(task: ":app:assembleBenchDebug")
    gradle(task: ":app:assembleBenchDebugAndroidTest")

    # Kill all three animation scales for crisp captures. (POST_NOTIFICATIONS is
    # handled inside the journey via GrantPermissionRule, so a fresh install
    # won't pop the dialog that otherwise covers the feed.)
    dev = serial.shellescape
    %w[window_animation_scale transition_animation_scale animator_duration_scale].each do |scale|
      sh("adb -s #{dev} shell settings put global #{scale} 0 || true")
    end

    capture_android_screenshots(
      app_package_name: "net.kikin.nubecita",
      tests_package_name: "net.kikin.nubecita.test",
      app_apk_path: "app/build/outputs/apk/bench/debug/app-bench-debug.apk",
      tests_apk_path: "app/build/outputs/apk/androidTest/bench/debug/app-bench-debug-androidTest.apk",
      use_tests_in_classes: ["net.kikin.nubecita.screenshots.MarketingScreenshotJourney"],
      test_instrumentation_runner: "net.kikin.nubecita.core.testing.android.HiltTestRunner",
      locales: ["en-US"],
      # Don't wipe the phone bucket — tablet captures are relocated below.
      clear_previous_screenshots: false,
      reinstall_app: true,
      exit_on_test_failure: false,
      specific_device: serial,
    )

    # screengrab routes every capture to phoneScreenshots regardless of device;
    # relocate the freshly-captured (timestamped) tablet shots into the tenInch
    # bucket, stripping the timestamp so the composite + titles line up.
    base = nubecita_metadata_android_dir
    phone = File.join(base, "en-US", "images", "phoneScreenshots")
    ten = File.join(base, "en-US", "images", "tenInchScreenshots")
    FileUtils.mkdir_p(ten)
    Dir.glob(File.join(phone, "*.png")).each do |f|
      name = File.basename(f)
      next if name.include?("_framed")
      next unless name =~ /_\d{6,}\.png\z/ # only the just-captured, timestamped tablet shots
      FileUtils.mv(f, File.join(ten, name.sub(/_\d{6,}(\.png)\z/, '\1')))
    end

    # Backdrop + headline (no bezel) via ImageMagick — frameit has no modern
    # tablet frame. Script lives next to the brand assets.
    script = File.expand_path("../../frameit_assets/compose_tablet.sh", base)
    sh("bash #{script.shellescape} en-US")
  end

  desc "Capture the Wear OS Play Store screenshots from the Wear bench flavor."
  desc "Pass device:<adb serial> (a Wear device or emulator) when several are attached."
  lane :wear_screenshots do |options|
    # Bench flavor -> a signed-in fake session and a fixed clock, with no paired
    # phone needed (nubecita-sn52.5). Unlike the phone lanes there is NO
    # framing step: Play rejects framed / masked Wear screenshots (WO-G5), so
    # the raw 1:1 captures in images/wearScreenshots/ are the listing images
    # (and are committed; see .gitignore).
    gradle(task: ":wear:app:assembleBenchDebug")
    gradle(task: ":wear:app:assembleBenchDebugAndroidTest")
    capture_android_screenshots(
      app_package_name: "net.kikin.nubecita",
      tests_package_name: "net.kikin.nubecita.test",
      app_apk_path: "wear/app/build/outputs/apk/bench/debug/app-bench-debug.apk",
      tests_apk_path: "wear/app/build/outputs/apk/androidTest/bench/debug/app-bench-debug-androidTest.apk",
      use_tests_in_classes: ["net.kikin.nubecita.wear.screenshots.WearMarketingScreenshotJourney"],
      test_instrumentation_runner: "androidx.test.runner.AndroidJUnitRunner",
      device_type: "wear",
      locales: ["en-US"],
      clear_previous_screenshots: true,
      reinstall_app: true,
      exit_on_test_failure: true,
      specific_device: options[:device],
    )
    # screengrab appends a capture timestamp (01_home_1792977117895.png);
    # strip it so re-running the lane rewrites the same committed files.
    shots = File.expand_path("metadata/android/en-US/images/wearScreenshots", __dir__)
    Dir.glob(File.join(shots, "*.png")).each do |path|
      File.rename(path, path.sub(/_\d{6,}\.png\z/, ".png"))
    end
  end
end
